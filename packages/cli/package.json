{
  "name": "llm-usage-tracker",
  "version": "1.0.4",
  "description": "CLI for LLM Usage Tracker - automatically intercepts and records all LLM API requests.",
  "author": "orzroa",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orzroa/llm-usage-tracker.git"
  },
  "keywords": [
    "llm",
    "api",
    "usage",
    "tracking",
    "statistics",
    "proxy"
  ],
  "bin": {
    "lut": "dist/cli.js",
    "llm-usage-tracker": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --outfile=dist/cli.js && mkdir -p dist/ui && cp ../ui/dist/index.html dist/ui/",
    "dev": "tsx src/cli.ts"
  },
  "dependencies": {
    "minimist": "^1.2.8"
  },
  "devDependencies": {
    "@llm-usage-tracker/core": "workspace:*",
    "@llm-usage-tracker/server": "workspace:*",
    "@types/minimist": "^1.2.5",
    "@types/node": "^24.0.15",
    "esbuild": "^0.25.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.2"
  }
}
